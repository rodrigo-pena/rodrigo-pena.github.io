---
import Head from "../components/Head.astro";
import { siteConfig } from "../site.config";

type Props = {
    frontmatter?: {
        modified?: string | Date;
        title?: string;
        description?: string;
    };
    modified?: string | Date;
    title?: string;
    description?: string;
};

const frontmatter = Astro.props.frontmatter ?? {};
const modifiedValue = Astro.props.modified ?? frontmatter.modified;
const title = Astro.props.title ?? frontmatter.title;
const description = Astro.props.description ?? frontmatter.description;

const emailAddress = `${siteConfig.owner.email.handle}@${siteConfig.owner.email.provider}`;

const modifiedDate = modifiedValue ? new Date(modifiedValue) : null;

const modifiedLabel =
    modifiedDate && !Number.isNaN(modifiedDate.getTime())
        ? modifiedDate.toLocaleDateString("en-US", {
              month: "long",
              day: "2-digit",
              year: "numeric",
          })
        : null;
---

<!doctype html>
<html lang="en">
    <Head title={title} description={description} />
    <body>
        <div class="wrapper">
            <header>
                <div class="logo-container">
                    <a
                        class="logo"
                        href="/"
                        aria-label={`${siteConfig.owner.author} homepage`}
                    >
                        <img
                            src={siteConfig.owner.logo}
                            alt={`Illustrated portrait of ${siteConfig.owner.author}. Commissioned from Felipe Portugal.`}
                            width="924"
                            height="920"
                        />
                    </a>
                </div>

                <div class="author-container"><h1>{siteConfig.owner.author}</h1></div>

                <div class="tagline-container"><p>{siteConfig.owner.tagline}</p></div>
            </header>

            <main>
                <div class="content">
                    <slot />
                </div>

                <nav
                    class="profile-navigation"
                    aria-labelledby="profile-navigation-title"
                >
                    <h2 id="profile-navigation-title">Links &amp; contact</h2>

                    <ul class="profile-link-list profile-link-list-primary">
                        {
                            siteConfig.primaryLinks.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))
                        }
                        <li><a href={`mailto:${emailAddress}`}>Email</a></li>
                    </ul>

                    <p class="profile-link-label">More profiles</p>
                    <ul class="profile-link-list profile-link-list-secondary">
                        {
                            siteConfig.secondaryLinks.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>

                {
                    modifiedLabel && (
                        <footer class="poweredby">
                            <p>(Page updated on {modifiedLabel})</p>
                        </footer>
                    )
                }
            </main>
        </div>
    </body>
</html>
